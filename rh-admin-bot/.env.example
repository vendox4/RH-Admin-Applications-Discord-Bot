# Add DISCORD_TOKEN using Replit Secrets. Never commit the real token.
DISCORD_TOKEN=

# Optional checks and command scoping.
CLIENT_ID=
GUILD_ID=

# Persistent SQLite file (relative to rh-admin-bot/ when using the workspace workflow).
DATABASE_PATH=./data/rh_applications.sqlite
LOG_FILE=./logs/bot.log

DEFAULT_COOLDOWN_DAYS=7
APPLICATION_TIME_LIMIT_MINUTES=60
APPLICATION_WARNING_MINUTES=10
UNDER_REVIEW_DAYS=7
ENABLE_TIMER_WARNING=true
MAX_ANSWER_LENGTH=4000

# Comma-separated Discord role IDs. REQUIRED_ROLE_MODE accepts ANY or ALL.
REQUIRED_ROLE_IDS=
REQUIRED_ROLE_MODE=ANY
APPLICATION_MANAGER_ROLE_IDS=
PING_ROLE_IDS=

# Optional IDs. /autoconf discovers or creates missing channels and roles.
APPLICATION_CATEGORY_ID=
MAIN_APPLY_CHANNEL_ID=
PENDING_CHANNEL_ID=
ACCEPTED_CHANNEL_ID=
DENIED_CHANNEL_ID=
APPLICATION_LOGS_CHANNEL_ID=
RH_APPLICANT_ROLE_ID=
RH_UNDER_REVIEW_ROLE_ID=
RH_ADMIN_DENIED_ROLE_ID=

# Manual only. The bot never creates or assigns this role.
RH_ADMIN_ROLE_ID=
MAIN_APPLICATION_MESSAGE_ID=

# Optional hosted GIF URLs. If blank, /autoconf uploads the supplied GIF files
# once to the private application-logs channel and saves their Discord URLs.
MAIN_APPLICATION_GIF=
CONFIRMATION_GIF=
QUESTION_GIF=
SUBMITTED_GIF=
PENDING_GIF=
ACCEPTED_GIF=
DENIED_GIF=
UNDER_REVIEW_GIF=
EXPIRED_GIF=
CANCELLED_GIF=
USER_LEFT_GIF=
READY_FOR_ADMIN_GIF=

AUTOCONF_CREATE_CHANNELS=true
AUTOCONF_CREATE_ROLES=true
NODE_ENV=production
